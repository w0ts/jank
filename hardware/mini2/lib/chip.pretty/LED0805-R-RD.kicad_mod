(module LED0805-R-RD (layer F.Cu) (tedit 5DC5F6A4)
	(descr "0805")
	(attr smd)
	(fp_text reference REF** (at 0.000 -4.000) (layer F.SilkS)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text value LED0805-R-RD (at 0.000 4.000) (layer F.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text user %R (at 0 0) (layer F.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "LCSC Part" "C2297")
	(pad 2 smd rect (at -1.05 0.00 180.00) (size 1.000 1.400) (layers F.Cu F.Paste F.Mask))
	(pad 1 smd rect (at 1.05 0.00 180.00) (size 1.000 1.400) (layers F.Cu F.Paste F.Mask))
	(model "${KIPRJMOD}/lib/3d/LED0805-RD.wrl"
		(offset (xyz 0.000 0.000 0.000))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
	(fp_line (start -2.370 -1.160) (end 2.140 -1.160) (layer F.CrtYd) (width 0.05))
	(fp_line (start 2.140 -1.160) (end 2.140 1.190) (layer F.CrtYd) (width 0.05))
	(fp_line (start 2.140 1.190) (end -2.370 1.190) (layer F.CrtYd) (width 0.05))
	(fp_line (start -2.370 1.190) (end -2.370 -1.160) (layer F.CrtYd) (width 0.05))
)
