(version 1)
# The USB-C's two locating holes (JLC's own footprint for C2765186) sit 0.18 mm from its outer ground pads; the
# manufacturer's layout, kept as drawn (README "DRC"): 0.15 mm allowed between J1's own holes and pads only.
(rule "J1 locating holes"
  (condition "A.Parent == 'J1' && B.Parent == 'J1'")
  (constraint hole_clearance (min 0.15mm)))
