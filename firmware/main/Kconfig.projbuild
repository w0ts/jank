menu "jank"
    choice JANK_BOARD
        prompt "Board"
        default JANK_BOARD_XIAO
        config JANK_BOARD_XIAO
            bool "Seeed XIAO ESP32S3"
            depends on IDF_TARGET_ESP32S3
    endchoice

    config JANK_BLE_MIDI
        bool "BLE MIDI peripheral for the control line"
        depends on BT_NIMBLE_ENABLED
        default n
        help
            The standard BLE MIDI service (main/ble_midi.c): the control line's SysEx and the beat reports, both ways,
            for a phone or a computer. Needs Bluetooth with NimBLE (firmware/sdkconfig.ble).
endmenu
