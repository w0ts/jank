# SPDX-License-Identifier: GPL-3.0-only
# The LINE IN's DMA interrupt runs with the cache off (CONFIG_ADC_CONTINUOUS_ISR_IRAM_SAFE): what it calls must be in IRAM
# (ESP-IDF adc_continuous.rst "IRAM Safe"; api-guides/linker-script-generation.rst). core/jank_line.c's frame parser:
[mapping:jank_line]
archive: libmain.a
entries:
    jank_line:jl_parse (noflash)

# the last panic's record is packed by the panic hook (panic_info.c), which runs after a crash: no flash
[mapping:jank_panic]
archive: libmain.a
entries:
    jank_panic:jk_panic_pack (noflash)
    jank_panic:jk_panic_valid (noflash)
