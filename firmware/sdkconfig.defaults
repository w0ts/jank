# SPDX-License-Identifier: GPL-3.0-only
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# UART0's pins are free for MIDI on boards that want them; USB belongs to TinyUSB
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Wi-Fi: a station that never associates; nothing of an access point, no Bluetooth
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
# Internal RAM for the USB host (owner 2026-11-25, "let's try to optimise"; measured: Wi-Fi's start took 41.8 KB of the heap in host mode, and the
# controllers' claims failed for want of internal DMA RAM). Wi-Fi here carries the control lines, MIDI, Link and updates: light traffic. So its code
# runs from flash, not IRAM (the two options: about 25 KB by ESP-IDF's notes), and it keeps 4 static RX buffers (1.6 KB of internal DMA RAM each)
# with a Block Ack window to match (ESP-IDF: the window not larger than the static buffers)
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
# no flash writes while playing (the timing audit): Wi-Fi keeps nothing in NVS (radio.c sets WIFI_STORAGE_RAM as well)
CONFIG_ESP_WIFI_NVS_ENABLED=n
# no power management: no frequency switches or light sleep under the clock's interrupt (off by default; said here so a
# fragment cannot turn it on unnoticed)
CONFIG_PM_ENABLE=n

# MIDI clock: the timer interrupt keeps running while flash is written (settings)
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=y
CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=y
CONFIG_GPTIMER_ISR_CACHE_SAFE=y
CONFIG_GPTIMER_OBJ_CACHE_SAFE=y
# LINE IN (linein.c): the ADC's DMA interrupt keeps filling while flash is written (the timing audit, trap 1; ESP-IDF
# adc_continuous.rst "IRAM Safe"); its callback and jl_parse are in IRAM (main/linker.lf)
CONFIG_ADC_CONTINUOUS_ISR_IRAM_SAFE=y
