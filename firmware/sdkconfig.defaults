# SPDX-License-Identifier: GPL-3.0-only
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# UART0's pins are free for MIDI on boards that want them; USB belongs to TinyUSB
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Wi-Fi: a station that never associates; nothing of an access point, no Bluetooth
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y

# MIDI clock: the timer interrupt keeps running while flash is written (settings)
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=y
CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=y
CONFIG_GPTIMER_ISR_CACHE_SAFE=y
CONFIG_GPTIMER_OBJ_CACHE_SAFE=y
