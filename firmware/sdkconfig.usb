# USB: CDC-NCM + MIDI + a read-only drive with the control page (no CDC-ACM: main/usb.c, the IN endpoints)
CONFIG_TINYUSB_MSC_ENABLED=y
# host mode: USB-MIDI devices, through a hub too
CONFIG_USB_HOST_HUBS_SUPPORTED=y
# updates over USB MIDI: two app slots, and a new image that does not confirm itself (main/ota.c) is replaced by the old one at the next reset
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_usb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_usb.csv"
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_WL_SECTOR_MODE_PERF=y
# the FAT image and the wear levelling must share one sector size (4096 FAT on 512 WL: macOS saw no file system, 2026-11-11)
CONFIG_FATFS_SECTOR_512=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_TINYUSB_CDC_COUNT=0
CONFIG_TINYUSB_MIDI_COUNT=1
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="jank"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="jank"
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=n
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x4A4B
